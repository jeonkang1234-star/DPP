# HTTPS 서버 설정 템플릿(2026-10-08) - docker-compose.https.yml 이 frontend 컨테이너의
# /etc/nginx/templates/default.conf.template 로 마운트한다. nginx 공식 이미지가 시작할 때
# ${DPP_DOMAIN} 같은 "정의된 환경변수"만 치환해 /etc/nginx/conf.d/default.conf 를 만든다
# ($host·$request_uri 같은 nginx 변수는 환경변수가 아니라서 그대로 남는다).
#
# 절차와 인증서 발급은 docker/HTTPS.md 참고.

# 도메인으로 들어온 HTTP 는 인증서 갱신 토큰만 내주고 나머지는 HTTPS 로 보낸다.
server {
    listen 80;
    server_name ${DPP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# IP 로 직접 들어온 HTTP(예: http://100.55.103.102)도 도메인 HTTPS 로 보낸다 - 시연 때
# 예전 주소로 열어도 자물쇠가 붙은 주소로 넘어가게. 단 컨테이너 안 헬스체크(localhost)는
# 그대로 응답해야 해서 기본 서버는 내용을 그대로 내준다.
server {
    listen 80 default_server;
    server_name _;

    if ($host != "localhost") {
        return 301 https://${DPP_DOMAIN}$request_uri;
    }

    include /etc/nginx/snippets/dpp-locations.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DPP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DPP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DPP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 브라우저가 이 도메인을 1년간 HTTPS 로만 열게 한다.
    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/dpp-locations.conf;
}
